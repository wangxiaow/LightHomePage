# Publish only application sources, deployment files, documentation and licenses.
/*
!/.gitignore
!/.dockerignore
!/README.md
!/LICENSE
!/package.json
!/server.mjs
!/client-address.mjs
!/SECURITY.md
!/Dockerfile
!/compose.yaml

!/public/
/public/*
!/public/index.html
!/public/styles.css
!/public/app.js
!/public/core.js
!/public/images.js
!/public/network.js
!/public/favicon.svg
!/public/license.txt
!/public/third-party-notices.txt

!/deploy/
/deploy/*
!/deploy/nginx.conf
!/deploy/proxy.conf

# Local verification files are not published to either remote.
/test/
/.github/

!/licenses/
/licenses/*
!/licenses/feather-MIT.txt
